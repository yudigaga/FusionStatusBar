<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/enable_steps"
            android:textSize="16sp" />

        <Button
            android:id="@+id/restart_systemui_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/restart_systemui" />

        <Button
            android:id="@+id/export_logs_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/export_logs" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/preview_frame"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="#FF1C242C">

            <com.xtjm.fusionstatusbar.FusionPreviewBackdrop
                android:id="@+id/preview_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.xtjm.fusionstatusbar.FusionIconView
                android:id="@+id/preview"
                android:layout_width="wrap_content"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:tag="preview" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/preview_note"
            android:textColor="#FFB7C0CC"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/preview_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/preview_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/preview_wifi" />

            <RadioButton
                android:id="@+id/preview_mobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/preview_mobile" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/size_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/icon_size_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/icon_size" />

            <TextView
                android:id="@+id/icon_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFB7C0CC" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/icon_size_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stroke_size" />

            <TextView
                android:id="@+id/stroke_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFB7C0CC" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/stroke_size_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/clock_settings_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <android.widget.Switch
            android:id="@+id/custom_clock_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/custom_clock" />

        <TextView
            android:id="@+id/clock_format_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:labelFor="@id/clock_format_input"
            android:text="@string/clock_format" />

        <EditText
            android:id="@+id/clock_format_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLength="80"
            android:maxLines="1" />

        <TextView
            android:id="@+id/clock_format_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clock_format_invalid"
            android:textColor="#FFD95B57"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/clock_format_tokens"
            android:textColor="#FFB7C0CC"
            android:textSize="13sp" />

        <android.widget.Switch
            android:id="@+id/show_weather_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/show_weather" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/telemetry_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/telemetry_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <android.widget.Switch
            android:id="@+id/dual_speed_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/telemetry_dual_speed" />

        <android.widget.Switch
            android:id="@+id/current_ma_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/telemetry_current_ma" />

        <android.widget.Switch
            android:id="@+id/current_positive_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/telemetry_current_positive" />

        <TextView
            android:id="@+id/telemetry_size_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/telemetry_size" />

        <SeekBar
            android:id="@+id/telemetry_size_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/layout_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <android.widget.Switch
            android:id="@+id/double_row_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/double_row" />

        <LinearLayout
            android:id="@+id/element_position_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/clock_position"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/clock_side"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/clock_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/side_left" />
                <RadioButton
                    android:id="@+id/clock_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/side_right" />
            </RadioGroup>
            <RadioGroup
                android:id="@+id/clock_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/clock_row_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_top" />
                <RadioButton
                    android:id="@+id/clock_row_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/row_bottom" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/notification_position"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/notification_side"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/notification_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/side_left" />
                <RadioButton
                    android:id="@+id/notification_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/side_right" />
            </RadioGroup>
            <RadioGroup
                android:id="@+id/notification_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/notification_row_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_top" />
                <RadioButton
                    android:id="@+id/notification_row_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/row_bottom" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/system_position"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/system_side"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/system_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/side_left" />
                <RadioButton
                    android:id="@+id/system_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/side_right" />
            </RadioGroup>
            <RadioGroup
                android:id="@+id/system_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/system_row_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_top" />
                <RadioButton
                    android:id="@+id/system_row_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/row_bottom" />
            </RadioGroup>

        </LinearLayout>

        <TextView
            android:id="@+id/statusbar_height_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/statusbar_height" />

        <SeekBar
            android:id="@+id/statusbar_height_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="64" />

        <android.widget.Switch
            android:id="@+id/span_rows_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/span_rows" />

        <LinearLayout
            android:id="@+id/span_position_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/span_horizontal" />

                <TextView
                    android:id="@+id/span_horizontal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFB7C0CC" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/span_horizontal_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/span_vertical" />

                <TextView
                    android:id="@+id/span_vertical_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFB7C0CC" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/span_vertical_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48" />
        </LinearLayout>

        <android.widget.Switch
            android:id="@+id/wifi_icon_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wifi_icon" />
    </LinearLayout>
</ScrollView>
