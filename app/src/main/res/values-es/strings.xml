    <string name="desktop_back_hold_delay_value">%1$d ms</string>
    <string name="desktop_back_hold_threshold_summary">Distancia: %1$s · Pausa: %2$d ms</string>
    <string name="desktop_back_hold_distance_help">Distancia que debes deslizar desde el borde de la pantalla antes de iniciar la pausa. Desactiva la distancia del sistema para introducir entre 16 y 240 dp; los dp se convierten según la densidad de la pantalla.</string>
    <string name="desktop_back_hold_delay_help">Tiempo hasta la segunda vibración, que indica que la acción está lista, tras alcanzar la distancia y mantener la posición. Intervalo: 200–3000 ms; valor predeterminado: 500 ms.</string>
    <string name="desktop_back_hold_distance_input">Distancia personalizada (dp)</string>
    <string name="desktop_back_hold_delay_input">Duración de la pausa (ms)</string>
    <string name="desktop_back_hold_distance_invalid">Introduce una distancia entera entre 16 y 240</string>
    <string name="desktop_back_hold_delay_invalid">Introduce una duración entera entre 200 y 3000 ms</string>
    <string name="desktop_back_hold_reset">Restablecer umbrales</string>
    <string name="desktop_back_appearance">Aspecto del gesto Atrás</string>
    <string name="desktop_back_appearance_summary">Configura la animación y los colores base de los indicadores de Atrás en ambos bordes. Los colores se adaptan al tema claro u oscuro del sistema. Activa los ámbitos del lanzador del sistema y de la interfaz del sistema. Atrás y Atrás con pausa comparten este aspecto.</string>
